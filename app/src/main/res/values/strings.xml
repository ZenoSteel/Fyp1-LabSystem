    <!-- AboutUsActivity -->
    <string name="title_about_us">About Us</string>
    <string name="about_purpose_title">Our Purpose</string>
    <string name="about_purpose_desc">This application is a final year project designed to manage lab reservations efficiently. It allows students and staff to browse available labs, check real-time availability, and book slots for their academic needs.</string>
